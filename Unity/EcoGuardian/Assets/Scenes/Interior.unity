  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Recuerden que este no es solo un operativo de supervivencia; es una misi\xF3n
    para recuperar el futuro. El planeta ya no tiene margen para m\xE1s fallos. Al
    completar la tarea, ustedes no solo estar\xE1n restaurando un centro de investigaci\xF3n,
    sino que estar\xE1n marcando el comienzo de la recuperaci\xF3n del equilibrio
    ecol\xF3gico.\nTomen sus posiciones y prep\xE1rense para operar. La Tierra los
    necesita m\xE1s que nunca.\n\nComandante Inara Helstrom\nComando Central EcoGuardian"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
