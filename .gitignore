# EcoGuardians - Unity projects + Blender
# Applies to both Unity/EcoGuardian and Unity/EcoGuardians.
# Keep Assets/*.meta, Packages/manifest.json, Packages/packages-lock.json,
# and ProjectSettings/ committed.

# Generated standalone game distribution at repository root
# Do NOT ignore Unity/EcoGuardians/ (the Unity source project).
/EcoGuardians/
/*.rar

# Unity-generated caches, temporary files and builds (at any depth)
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emory[Cc]aptures/
**/[Rr]ecordings/
**/[Ee]xported[Oo]bj/

# IDE and editor state
.vs/
.idea/
.vscode/
.consulo/
.gradle/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.opendb

# Unity-generated debugger metadata and crash reports
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# Unity package/build output (not source assets)
*.apk
*.aab
*.ipa
*.unitypackage
*.app/
crashlytics-build.properties

# Unity-generated Android/Addressables data
**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
**/[Aa]ssets/[Ss]treaming[Aa]ssets/aa.meta
**/[Aa]ssets/[Ss]treaming[Aa]ssets/aa/

# Rider auto-generated integration
**/[Aa]ssets/[Pp]lugins/[Ee]ditor/[Jj]et[Bb]rains*/

# Blender automatic backup files; keep original .blend files
*.blend[0-9]*

# OS and temporary editor files
.DS_Store
Thumbs.db
Desktop.ini
*~
*.bak
*.tmp
*.swp
*.swo

# Exterior: datos de iluminacion horneada demasiado grandes
/Unity/EcoGuardian/Assets/Scenes/Exterior/LightingData.asset
/Unity/EcoGuardian/Assets/Scenes/Exterior/LightingData.asset.meta

# Audio assets - local only
/Unity/EcoGuardian/Assets/Sound/
/Unity/EcoGuardian/Assets/Sound.meta
